{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/mcpb/70fe3b34cd6dff1b3bba046638edc72a6467a4fb/schemas/mcpb-manifest-v0.4.schema.json",
  "manifest_version": "0.4",
  "name": "corresync",
  "display_name": "Corresync — Mail & Calendar",
  "version": "{{ .Version }}",
  "description": "Local-first mail and calendar MCP server for accounts you control.",
  "long_description": "Corresync brings isolated Outlook, Google, Microsoft 365, JMAP, IMAP/SMTP, and CalDAV accounts into one guarded local MCP server. It runs on your device over stdio, keeps authentication in an explicit local browser or approved credential store, and requires preview-before-commit writes. Install the Corresync CLI separately to configure and authenticate accounts; the bundle never hosts or relays mailbox data.",
  "author": {
    "name": "Corresync contributors",
    "url": "https://github.com/nkiyohara/corresync"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nkiyohara/corresync.git"
  },
  "homepage": "https://corresync.org/",
  "documentation": "https://github.com/nkiyohara/corresync/blob/main/docs/mcp.md",
  "support": "https://github.com/nkiyohara/corresync/issues",
  "icon": "icon.png",
  "server": {
    "type": "binary",
    "entry_point": "server/launch.sh",
    "mcp_config": {
      "command": "${__dirname}/server/launch.sh",
      "args": [],
      "env": {},
      "platform_overrides": {
        "win32": {
          "command": "cmd.exe",
          "args": [
            "/d",
            "/s",
            "/c",
            "\"${__dirname}/server/launch.cmd\""
          ]
        }
      }
    }
  },
  "tools_generated": true,
  "keywords": [
    "mail",
    "calendar",
    "productivity",
    "local-first",
    "privacy",
    "mcp",
    "stdio"
  ],
  "license": "Apache-2.0",
  "privacy_policies": [
    "https://corresync.org/privacy.html"
  ],
  "compatibility": {
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
